# Example env for GDP Spark Connect (G11.3)
# Copy to a local .env (do not commit real tokens) and point Connection
# fetch method to "Environment Variables from .env file".
#
# Naming convention for Connection nodes on the canvas:
#   gdp-<namespace-short>-<session-name>
#   e.g. gdp-dev-Test2 , gdp-dev-KyleTest

# Full External URL including Connect ID (no token preferred here)
SPARK_CONNECT_URL=sc://spark-connect-dedicated.example.com:443/;x-gdp-connect-id:REDACTED_CONNECT_ID

# Access token for External gateway (keep out of .ampln)
SPARK_TOKEN=

# Optional metadata (Browse may write these; runtime uses URL)
GDP_CONNECT_ID=REDACTED_CONNECT_ID
GDP_CONNECT_NAME=Test2

# Optional app name
SPARK_APP_NAME=amphi-spark-sql-input
